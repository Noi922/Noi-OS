#!/bin/sh
# Noi OS Server: Begrüßung bei der Anmeldung (Konsole und SSH)
. /etc/os-release 2>/dev/null
G=$(printf '\033[38;2;122;154;58m'); L=$(printf '\033[38;2;201;211;160m')
B=$(printf '\033[1m'); R=$(printf '\033[0m')
ips=$(ip -4 -o addr show scope global 2>/dev/null | awk '{sub(/\/.*/, "", $4); print $4}' | tr '\n' ' ')
first=${ips%% *}
printf '\n  %s%s%s%s  ·  %s\n\n' "$G" "$B" "${PRETTY_NAME:-Noi OS Server}" "$R" "$(hostname)"
if [ -n "$first" ]; then
    printf '  %sIP-Adresse%s      %s\n' "$L" "$R" "$ips"
    printf '  %sWeb-Verwaltung%s  https://%s:9090\n' "$L" "$R" "$first"
else
    printf '  %sNetzwerk%s        keine IP-Adresse –  noi netz  zeigt, woran es liegt\n' "$L" "$R"
fi
printf '  %sAuslastung%s      %s  ·  Speicher %s  ·  Platte %s\n' "$L" "$R" \
    "$(cut -d' ' -f1-3 /proc/loadavg)" \
    "$(free -h --si 2>/dev/null | awk '/^Mem/{print $3 "/" $2}')" \
    "$(df -h / 2>/dev/null | awk 'NR==2{print $3 "/" $2 " (" $5 ")"}')"
[ -f /var/run/reboot-required ] && printf '  %s!%s Neustart nötig, damit Updates aktiv werden\n' "$B" "$R"
printf '\n  Hilfe:  %snoi hilfe%s   ·   System prüfen:  %snoi doktor%s\n\n' "$B" "$R" "$B" "$R"
