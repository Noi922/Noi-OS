# Tab-Vervollständigung für das noi-Werkzeug von Noi OS
_noi() {
    local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}
    case $prev in
        thema)       mapfile -t COMPREPLY < <(compgen -W "hell dunkel" -- "$cur") ;;
        hintergrund) mapfile -t COMPREPLY < <(compgen -W "wald wueste nacht winter" -- "$cur") ;;
        paket)       mapfile -t COMPREPLY < <(compgen -W "gaming kreativ medien kommunikation entwicklung liste" -- "$cur") ;;
        dev)         mapfile -t COMPREPLY < <(compgen -W "python node c java go rust php liste" -- "$cur") ;;
        port)        mapfile -t COMPREPLY < <(compgen -W "auf zu liste" -- "$cur") ;;
        shell)       mapfile -t COMPREPLY < <(compgen -W "hamster bash" -- "$cur") ;;
        noi)         mapfile -t COMPREPLY < <(compgen -W "update info aufraeumen sicherung doktor netz status port shell paket dev bericht thema hintergrund zentrale hilfe" -- "$cur") ;;
    esac
}
complete -F _noi noi
