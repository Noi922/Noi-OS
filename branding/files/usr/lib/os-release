PRETTY_NAME="@DISTRO_NAME@ @DISTRO_VERSION@"
NAME="@DISTRO_NAME@"
VERSION_ID="@UBUNTU_VERSION@"
VERSION="@DISTRO_VERSION@ (@DISTRO_CODENAME@)"
VERSION_CODENAME=@UBUNTU_CODENAME@
# ID bleibt "ubuntu" (wie bei Kubuntu): Sicherheitsupdates (unattended-upgrades),
# PPAs und Treiber-Werkzeuge erkennen das System daran. Sichtbar ist überall
# "Noi OS" (NAME/PRETTY_NAME/VARIANT).
ID=ubuntu
ID_LIKE=debian
VARIANT="@DISTRO_NAME@"
VARIANT_ID=@DISTRO_ID@
HOME_URL="@HOME_URL@"
SUPPORT_URL="@SUPPORT_URL@"
BUG_REPORT_URL="@BUG_URL@"
LOGO=@DISTRO_ID@-logo
UBUNTU_CODENAME=@UBUNTU_CODENAME@
NOIOS_VERSION="@DISTRO_VERSION@"
