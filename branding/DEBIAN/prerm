#!/bin/sh
set -e
T=/usr/share/plymouth/themes
if [ "$1" = remove ]; then
    update-alternatives --remove default.plymouth "$T/noios/noios.plymouth" || true
    update-alternatives --remove text.plymouth "$T/noios/noios-text.plymouth" || true
    find "$T/noios" -name "*.png" ! -name watermark.png -delete 2>/dev/null || true
fi
